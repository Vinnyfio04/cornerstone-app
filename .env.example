# Copy this file to the ignored .env file. OpenAI mode makes paid API calls.
# Omit CHAT_PROVIDER to select OpenAI when a key is present, otherwise mock.
CHAT_PROVIDER=openai

# OPEN_AI_API_KEY matches the existing project .env naming. The backend also
# accepts the conventional OPENAI_API_KEY name without returning either value.
OPEN_AI_API_KEY=

# Required for gpt-live-1 delegated Responses work. Text chat also accepts this
# as a fallback; OPENAI_CHAT_MODEL takes precedence for text chat only.
VOICE_BACKEND_MODEL=
OPENAI_CHAT_MODEL=

# Copy this file to the ignored .env file only for approved paid model checks.
# Production text chat always uses OpenAI. Missing configuration returns a
# recoverable model_unavailable result; there is no CHAT_PROVIDER mock switch.
# Routine and peer checks use the isolated test helper in docs/evaluation.md.

# OPEN_AI_API_KEY matches the existing project .env naming. The backend also
# accepts the conventional OPENAI_API_KEY name without returning either value.
OPEN_AI_API_KEY=

# Required for gpt-live-1 delegated Responses work. Text chat also accepts this
# as a fallback; OPENAI_CHAT_MODEL takes precedence for text chat only.
VOICE_BACKEND_MODEL=
OPENAI_CHAT_MODEL=
